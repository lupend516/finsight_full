# MongoDB Atlas connection string
# Получи на: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/finsight?retryWrites=true&w=majority

# JWT secret — сгенерируй локально: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Порт сервера
PORT=5000

# Окружение: development | production
ENV=development

# CORS — адрес фронтенда
FRONTEND_URL=http://localhost:3000
